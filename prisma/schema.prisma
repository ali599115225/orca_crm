// 1. المولد الأساسي للـ Prisma Client
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTRA_ASSET
  CONTRA_REVENUE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  MARKETING
  READ_ONLY
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
  SOLD_OUT
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  RESERVED
  CONTRACT_SIGNED
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

// --- MODELS ---

model User {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String              @map("tenant_id") @db.Uuid
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String              @unique
  passwordHash   String              @map("password_hash")
  role           Role
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  leads          Lead[]              @relation("AssignedLeads")
  leadActivities LeadActivity[]
  tasks          Task[]
  commissions    PayrollCommission[]
  emailMessages  EmailMessage[]

  @@map("users")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  city        String
  status      ProjectStatus
  unitsTotal  Int           @default(0) @map("units_total")
  unitsSold   Int           @default(0) @map("units_sold")
  unitsBooked Int           @default(0) @map("units_booked")
  minPrice    Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice    Decimal?      @map("max_price") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  leads       Lead[]
  units       Unit[]

  @@map("projects")
}

model Lead {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId       String?          @map("project_id") @db.Uuid
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo      String?          @map("assigned_to") @db.Uuid
  assignedUser    User?            @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  firstName       String           @map("first_name")
  lastName        String?          @map("last_name")
  phone           String
  email           String?
  city            String
  source          String
  status          LeadStatus
  lostReason      String?          @map("lost_reason")
  leadScore       Int              @default(50) @map("lead_score")
  lastContactedAt DateTime?        @map("last_contacted_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  leadActivities  LeadActivity[]
  tasks           Task[]
  mansourChats    MansourChat[]
  whatsappContact WhatsAppContact?
  emailMessages   EmailMessage[]
  stage           String?
  score           Int?
  priority        String?
  aiSummary       String?          @map("ai_summary") @db.Text
  assignedAgentId String?          @map("assigned_agent_id") @db.Uuid
  unitId          String?          @map("unit_id") @db.Uuid
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  auditLog        String?          @map("audit_log") @db.Text

  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityType String   @map("activity_type")
  description  String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("lead_activities")
}

model Task {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String     @map("lead_id") @db.Uuid
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   String     @map("assigned_to") @db.Uuid
  assignedUser User       @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime   @map("due_date") @db.Timestamptz
  priority     Priority
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  auditLog     String?    @map("audit_log") @db.Text

  @@map("tasks")
}

model Tenant {
  id                        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName               String  @map("company_name")
  subdomain                 String  @unique
  subscriptionPlan          String  @default("basic") @map("subscription_plan")
  isActive                  Boolean @default(true) @map("is_active")
  contractTerms             String? @map("contract_terms") @db.Text
  commercialRegistry        String? @map("commercial_registry")
  vatNumber                 String? @map("vat_number")
  nationalAddress           String? @map("national_address")
  encryptedClientId         String? @map("encrypted_client_id")
  encryptedClientSecret     String? @map("encrypted_client_secret")
  encryptedApiKey           String? @map("encrypted_api_key")
  encryptedZatcaCredentials String? @map("encrypted_zatca_credentials")
  invoicePrefix             String  @default("INV") @map("invoice_prefix")
  nextInvoiceNumber         Int     @default(1) @map("next_invoice_number")

  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz
  paymentStatus         String    @default("UNPAID") @map("payment_status")
  billingCycle          String    @default("MONTHLY") @map("billing_cycle")
  extraAgents           Int       @default(0) @map("extra_agents")
  whatsappConnected     Boolean   @default(false) @map("whatsapp_connected")
  growthWarning         Boolean   @default(false) @map("growth_warning")

  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  users                User[]
  projects             Project[]
  leads                Lead[]
  leadActivities       LeadActivity[]
  tasks                Task[]
  tickets              Ticket[]
  agentSlots           AgentSlot[]
  usageMeters          UsageMeter[]
  commissions          PayrollCommission[]
  agentTelemetryLogs   AgentTelemetryLog[]
  auditLogs            AuditLog[]
  followupSequences    FollowupSequence[]
  mansourChats         MansourChat[]
  platformConnections  PlatformConnection[]
  agentLeases          AgentLease[]
  units                Unit[]
  contracts            Contract[]
  installments         Installment[]
  rentalInvoices       RentalInvoice[]
  receipts             Receipt[]
  generalLedgerEntries GeneralLedger[]
  contacts             Contact[]
  opportunities        Opportunity[]
  tours                Tour[]
  offers               Offer[]
  automationWorkflows  AutomationWorkflow[]
  telemetryEvents      TelemetryEvent[]
  rentalLeases         RentalLease[]
  zatcaDevices         ZatcaDevice[]
  zatcaQueueItems      ZatcaQueue[]
  accounts             Account[]
  accountBalances      AccountBalance[]
  journalEntries       JournalEntry[]
  paymentTransactions  PaymentTransaction[]
  commissionPayments   CommissionPayment[]
  maintenanceTickets   MaintenanceTicket[]
  whatsappContacts     WhatsAppContact[]
  whatsappMessages     WhatsAppMessage[]
  emailMessages        EmailMessage[]

  @@map("tenants")
}

model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  status      String   @default("OPEN")
  aiResponse  String?  @map("ai_response") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tickets")
}

model AgentSlot {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotNumber Int         @map("slot_number")
  agentType  String      @map("agent_type")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  usageMeter UsageMeter?

  @@unique([tenantId, slotNumber])
  @@map("agent_slots")
}

model UsageMeter {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentSlotId String?    @unique @map("agent_slot_id") @db.Uuid
  agentSlot   AgentSlot? @relation(fields: [agentSlotId], references: [id], onDelete: SetNull)
  metricType  String     @map("metric_type")
  limitValue  Int        @map("limit_value")
  usageValue  Int        @default(0) @map("usage_value")
  resetAt     DateTime   @map("reset_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@map("usage_meters")
}

model PayrollCommission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  contractId String   @map("contract_id")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  payments CommissionPayment[]

  @@map("payroll_commissions")
}

model Unit {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String    @map("project_id") @db.Uuid
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitNumber    String    @map("unit_number")
  floorPosition Int       @map("floor_position")
  priceSar      Decimal   @map("price_sar") @db.Decimal(12, 2)
  type          String?   @default("شقة سكنية")
  area          String?   @default("120 م²")
  beds          Int?
  city          String?
  district      String?
  lat           Float?
  lng           Float?
  agentName     String?   @map("agent_name")
  description   String?   @db.Text
  media         Json?     @default("[]")
  docs          Json?     @default("[]")
  events        Json?     @default("[]")
  handovers     Json?     @default("[]")
  tourType      String?   @map("tour_type")
  tourUrl       String?   @map("tour_url")
  status        String    @default("Available")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contract      Contract?

  @@unique([projectId, unitNumber], name: "uq_project_unit_number")
  @@index([projectId], map: "idx_units_project_id")
  @@index([tenantId], map: "idx_units_tenant_id")
  @@map("units")
}

model Contract {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId         String        @unique @map("unit_id") @db.Uuid
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  buyerName      String        @map("buyer_name")
  buyerPhone     String        @map("buyer_phone")
  totalVolumeSar Decimal       @map("total_volume_sar") @db.Decimal(12, 2)
  signedAt       DateTime      @default(now()) @map("signed_at") @db.Timestamptz
  endDate        DateTime?     @map("end_date") @db.Timestamptz
  status         String        @default("Active") @map("status")
  vatType        String        @default("STANDARD") @map("vat_type")
  vatRate        Decimal       @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  installments   Installment[]

  @@index([unitId], map: "idx_contracts_unit_id")
  @@index([tenantId], map: "idx_contracts_tenant_id")
  @@map("contracts")
}

model Installment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId         String   @map("contract_id") @db.Uuid
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber  Int      @map("installment_number")
  amountSar          Decimal  @map("amount_sar") @db.Decimal(12, 2)
  vatAmount          Decimal? @map("vat_amount") @db.Decimal(12, 2)
  dueDate            DateTime @map("due_date") @db.Date
  paymentStatus      String   @default("Pending") @map("payment_status")
  securePaymentToken String   @unique @default(dbgenerated("gen_random_uuid()")) @map("secure_payment_token") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([contractId, installmentNumber], name: "uq_contract_installment_number")
  @@index([contractId], map: "idx_installments_contract_id")
  @@index([dueDate], map: "idx_installments_due_date")
  @@index([tenantId], map: "idx_installments_tenant_id")
  @@map("installments")
}

model RentalLease {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId       String?         @map("unit_id") @db.Uuid
  unitName     String          @map("unit_name")
  tenantName   String          @map("tenant_name")
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime        @map("end_date") @db.Date
  rentAmount   Decimal         @map("rent_amount") @db.Decimal(12, 2)
  deposit      Decimal         @default(0) @map("deposit") @db.Decimal(12, 2)
  currency     String          @default("SAR")
  status       String          @default("active")
  financialRef String?         @map("financial_ref")
  vatType      String          @default("STANDARD") @map("vat_type")
  vatRate      Decimal         @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  invoices     RentalInvoice[]

  @@index([tenantId], map: "idx_rental_leases_tenant_id")
  @@map("rental_leases")
}

model RentalInvoice {
  id       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String      @map("tenant_id") @db.Uuid
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaseId  String      @map("lease_id") @db.Uuid
  lease    RentalLease @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  invoiceNumber Int    @map("invoice_number")
  invoicePrefix String @default("INV") @map("invoice_prefix")
  zatcaUuid     String @default(uuid()) @map("zatca_uuid") @db.Uuid

  issueDate DateTime @default(now()) @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  subtotal    Decimal @map("subtotal") @db.Decimal(12, 2)
  vatRate     Decimal @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount   Decimal @map("vat_amount") @db.Decimal(12, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(12, 2)

  qrPayload String? @map("qr_payload") @db.Text
  qrCode    String? @map("qr_code") @db.Text
  qrImage   String? @map("qr_image") @db.Text

  invoiceTypeCode     String  @default("388") @map("invoice_type_code")
  previousInvoiceHash String? @map("previous_invoice_hash")

  zatcaXml       String?   @map("zatca_xml") @db.Text
  zatcaSignedXml String?   @map("zatca_signed_xml") @db.Text
  zatcaStatus    String    @default("DRAFT") @map("zatca_status")
  zatcaResponse  String?   @map("zatca_response") @db.Text
  zatcaError     String?   @map("zatca_error") @db.Text
  zatcaClearedAt DateTime? @map("zatca_cleared_at") @db.Timestamptz

  status        String    @default("unpaid")
  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  paymentMethod String?   @map("payment_method")
  paymentRef    String?   @map("payment_ref")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  queueItems ZatcaQueue[]

  @@unique([tenantId, invoiceNumber], name: "uq_tenant_invoice_number")
  @@index([leaseId], map: "idx_rental_invoices_lease_id")
  @@index([tenantId], map: "idx_rental_invoices_tenant_id")
  @@map("rental_invoices")
}

model ZatcaDevice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deviceName     String    @map("device_name")
  deviceType     String    @default("COMPLIANCE") @map("device_type")
  csr            String?   @map("csr") @db.Text
  complianceCert String?   @map("compliance_cert") @db.Text
  productionCert String?   @map("production_cert") @db.Text
  privateKey     String    @map("private_key") @db.Text
  publicKey      String    @map("public_key") @db.Text
  status         String    @default("ACTIVE")
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId], map: "idx_zatca_devices_tenant_id")
  @@map("zatca_devices")
}

model ZatcaQueue {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId   String        @map("invoice_id") @db.Uuid
  invoice     RentalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  action      String        @default("REPORT")
  status      String        @default("PENDING")
  retryCount  Int           @default(0) @map("retry_count")
  maxRetries  Int           @default(5) @map("max_retries")
  lastError   String?       @map("last_error") @db.Text
  nextRetryAt DateTime?     @map("next_retry_at") @db.Timestamptz
  payload     String?       @map("payload") @db.Text
  response    String?       @map("response") @db.Text
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  completedAt DateTime?     @map("completed_at") @db.Timestamptz

  @@index([tenantId, status], map: "idx_zatca_queue_tenant_status")
  @@index([nextRetryAt], map: "idx_zatca_queue_next_retry")
  @@map("zatca_queue")
}

model AgentTelemetryLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String   @map("agent_id")
  actionType   String   @map("action_type")
  logMessageAr String   @map("log_message_ar") @db.Text
  severity     String   @default("Info")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId], map: "idx_telemetry_tenant_id")
  @@index([createdAt(sort: Desc)], map: "idx_telemetry_created_at")
  @@map("agent_telemetry_logs")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id") @db.Uuid
  action    String
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId], map: "idx_audit_logs_tenant_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

model FollowupSequence {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    String
  delayDays Int      @map("delay_days")
  message   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("followup_sequences")
}

model MansourChat {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String?  @map("lead_id") @db.Uuid
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  lastMessage  String   @map("last_message") @db.Text
  status       String   @default("INTERESTED")
  messagesJson String   @map("messages_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("mansour_chats")
}

model PlatformConnection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform        String
