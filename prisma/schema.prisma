  authorizedReleaseSha String?            @map("authorized_release_sha")
  firstExec007WriteAt DateTime?           @map("first_exec007_write_at") @db.Timestamptz
  version             Int                 @default(1)
  updatedByUserId     String?             @map("updated_by_user_id") @db.Uuid
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("exec007_cutover_control")
}

model Exec007CutoverTransitionHistory {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromMode             Exec007CutoverMode @map("from_mode")
  toMode               Exec007CutoverMode @map("to_mode")
  authorizedReleaseSha String?            @map("authorized_release_sha")
  expectedVersion      Int                @map("expected_version")
  actorUserId          String             @map("actor_user_id") @db.Uuid
  reason               String
  evidenceHash         String             @map("evidence_hash")
  transitionedAt       DateTime           @default(now()) @map("transitioned_at") @db.Timestamptz

  @@index([transitionedAt, id], map: "idx_exec007_cutover_history_time")
  @@map("exec007_cutover_transition_history")
}
