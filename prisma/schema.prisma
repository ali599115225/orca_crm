// ─── Government Outbox ────────────────────────────────────────────────────────
// Idempotent, provider-agnostic outbox for ZATCA and Ejar government calls.
// ZatcaQueue remains for ZATCA retry (legacy); GovernmentOutbox is for all new flows.
model GovernmentOutbox {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  provider String @db.VarChar(10)
  // "ZATCA" | "EJAR" — used to route cron workers

  operation String @db.VarChar(50)
  // "ZATCA_SUBMIT_INVOICE" | "EJAR_REGISTER_CONTRACT" | ...

  idempotencyKey String @unique(map: "gov_outbox_idempotency_key_uq") @map("idempotency_key") @db.VarChar(80)
  // SHA-256(tenantId:provider:operation:businessEntityType:businessEntityId)
  // UNIQUE guarantees exactly-once reservation via INSERT ON CONFLICT DO NOTHING

  businessEntityType String? @map("business_entity_type") @db.VarChar(30)
  // "invoice" | "device" | "device_creation" | "contract"

  businessEntityId String? @map("business_entity_id") @db.Uuid
  // invoice.id | device.id | contract.id — nullable for device_creation

  payload String @db.Text
  // Full JSON request payload stored for retry without recalculation

  status String @default("PENDING")
  // PENDING | PROCESSING | DELIVERED | RETRYING | FAILED | DEAD_LETTER

  retryCount Int @default(0) @map("retry_count")
  maxRetries Int @default(5) @map("max_retries")

  lastError String? @map("last_error") @db.Text
  // Last error from provider — for debugging

  nextRetryAt DateTime? @map("next_retry_at") @db.Timestamptz
  // Exponential backoff: 2^retryCount minutes. null = PENDING (process immediately)

  providerResponse String? @map("provider_response") @db.Text
  // Raw provider response (ejarContractId, zatcaStatus, ...) — stored for idempotent re-reads

  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  // Set when status transitions to DELIVERED — for SLA monitoring

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, status], map: "idx_gov_outbox_tenant_status")
  @@index([nextRetryAt, status], map: "idx_gov_outbox_retry")
  @@index([provider, status], map: "idx_gov_outbox_provider_status")
  @@map("government_outbox")
}

