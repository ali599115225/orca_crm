// prisma/schema.prisma

datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client-js"
}
  

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  MARKETING
  READ_ONLY
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
  SOLD_OUT
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  RESERVED
  CONTRACT_SIGNED
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String         @unique
  passwordHash   String         @map("password_hash")
  role           Role
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  leads          Lead[]         @relation("AssignedLeads")
  leadActivities LeadActivity[]
  tasks          Task[]
  commissions    PayrollCommission[]

  @@map("users")
}

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  city           String
  status         ProjectStatus
  unitsTotal     Int           @default(0) @map("units_total")
  unitsSold      Int           @default(0) @map("units_sold")
  unitsBooked    Int           @default(0) @map("units_booked")
  minPrice       Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice       Decimal?      @map("max_price") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  leads          Lead[]
  units          Unit[]

  @@map("projects")
}

model Lead {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String?        @map("project_id") @db.Uuid
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo     String?        @map("assigned_to") @db.Uuid
  assignedUser   User?          @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  firstName      String         @map("first_name")
  lastName       String?        @map("last_name")
  phone          String
  email          String?
  city           String
  source         String
  status         LeadStatus
  lostReason     String?        @map("lost_reason")
  leadScore      Int            @default(50) @map("lead_score")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  leadActivities LeadActivity[]
  tasks          Task[]

  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityType String   @map("activity_type")
  description  String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("lead_activities")
}

model Task {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      String     @map("lead_id") @db.Uuid
  lead        Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo  String     @map("assigned_to") @db.Uuid
  assignedUser User       @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime   @map("due_date") @db.Timestamptz
  priority    Priority
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@map("tasks")
}


model Tenant {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName         String         @map("company_name")
  subdomain           String         @unique
  subscriptionPlan    String         @default("basic") @map("subscription_plan")
  isActive            Boolean        @default(true) @map("is_active")
  contractTerms       String?        @map("contract_terms") @db.Text
  
  // 💎 حقول الفوترة والاشتراكات السحابية الجديدة لـ "سند" [1.1.2]
  subscriptionExpiresAt DateTime?      @map("subscription_expires_at") @db.Timestamptz
  paymentStatus       String         @default("UNPAID") @map("payment_status")
  billingCycle        String         @default("MONTHLY") @map("billing_cycle")
  extraAgents         Int            @default(0) @map("extra_agents")
  whatsappConnected   Boolean        @default(false) @map("whatsapp_connected")

  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  users               User[]
  projects            Project[]
  leads               Lead[]
  leadActivities      LeadActivity[]
  tasks               Task[]
  tickets             Ticket[]
  agentSlots          AgentSlot[]
  usageMeters         UsageMeter[]
  commissions         PayrollCommission[]
  agentTelemetryLogs  AgentTelemetryLog[]

  @@map("tenants")
}

model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  status      String   @default("OPEN") // OPEN, CLOSED
  aiResponse  String?  @map("ai_response") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tickets")
}

model AgentSlot {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotNumber  Int         @map("slot_number")
  agentType   String      @map("agent_type") // SAHER, SANAD, CHAT_BOT
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  usageMeter  UsageMeter?

  @@unique([tenantId, slotNumber])
  @@map("agent_slots")
}

model UsageMeter {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentSlotId String?     @unique @map("agent_slot_id") @db.Uuid
  agentSlot   AgentSlot?  @relation(fields: [agentSlotId], references: [id], onDelete: SetNull)
  metricType  String      @map("metric_type") // MESSAGES, RUNS, DISPATCHES
  limitValue  Int         @map("limit_value")
  usageValue  Int         @default(0) @map("usage_value")
  resetAt     DateTime    @map("reset_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("usage_meters")
}

model PayrollCommission {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(12, 2)
  contractId  String      @map("contract_id")
  status      String      @default("PENDING") // PENDING, PAID
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("payroll_commissions")
}

model Unit {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitNumber    String     @map("unit_number")
  floorPosition Int        @map("floor_position")
  priceSar      Decimal    @map("price_sar") @db.Decimal(12, 2)
  status        String     @default("Available") // Available, Reserved, Sold
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  contract      Contract?

  @@unique([projectId, unitNumber], name: "uq_project_unit_number")
  @@index([projectId], map: "idx_units_project_id")
  @@map("units")
}

model Contract {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String        @unique @map("unit_id") @db.Uuid
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  buyerName      String        @map("buyer_name")
  buyerPhone     String        @map("buyer_phone")
  totalVolumeSar Decimal       @map("total_volume_sar") @db.Decimal(12, 2)
  signedAt       DateTime      @default(now()) @map("signed_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  installments   Installment[]

  @@index([unitId], map: "idx_contracts_unit_id")
  @@map("contracts")
}

model Installment {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId         String        @map("contract_id") @db.Uuid
  contract           Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber  Int           @map("installment_number")
  amountSar          Decimal       @map("amount_sar") @db.Decimal(12, 2)
  dueDate            DateTime      @map("due_date") @db.Date
  paymentStatus      String        @default("Pending") @map("payment_status")
  securePaymentToken String        @unique @default(dbgenerated("gen_random_uuid()")) @map("secure_payment_token") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@unique([contractId, installmentNumber], name: "uq_contract_installment_number")
  @@index([contractId], map: "idx_installments_contract_id")
  @@index([dueDate], map: "idx_installments_due_date")
  @@map("installments")
}

model AgentTelemetryLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String   @map("agent_id") // SAHER or SANAD
  actionType   String   @map("action_type") // Lead_Screening, Link_Dispatched, Security_Lock, Payment_Confirmed
  logMessageAr String   @map("log_message_ar") @db.Text
  severity     String   @default("Info") // Info, Warning, Critical
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId], map: "idx_telemetry_tenant_id")
  @@index([createdAt(sort: Desc)], map: "idx_telemetry_created_at")
  @@map("agent_telemetry_logs")
}