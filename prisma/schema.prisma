  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, severity], map: "idx_sentinel_incidents_active")
  @@index([tenantId, status], map: "idx_sentinel_incidents_tenant_status")
  @@index([assignedToId, status], map: "idx_sentinel_incidents_assignee_status")
  @@index([correlationId], map: "idx_sentinel_incidents_correlation")
  @@index([requestId], map: "idx_sentinel_incidents_request")
  @@index([relatedTaskOrderId], map: "idx_sentinel_incidents_task_order")
  @@index([detectedAt(sort: Desc)], map: "idx_sentinel_incidents_detected")
