// === SPRINT 3: DOUBLE-ENTRY ACCOUNTING ===

model Account {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String      @map("tenant_id") @db.Uuid
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  nameAr    String      @map("name_ar")
  nameEn    String?     @map("name_en")
  type      AccountType
  parentId  String?     @map("parent_id") @db.Uuid
  parent    Account?    @relation("AccountHierarchy", fields: [parentId], references: [id])
  children  Account[]   @relation("AccountHierarchy")
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  journalLines JournalLine[]
  balances     AccountBalance[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("accounts")
}

model AccountBalance {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  period    String
  debit     Decimal  @default(0) @db.Decimal(15, 2)
  credit    Decimal  @default(0) @db.Decimal(15, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([accountId, period, tenantId])
  @@index([tenantId, period])
  @@index([accountId])
  @@map("account_balances")
}

model JournalEntry {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String             @map("tenant_id") @db.Uuid
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entryNumber  Int
  description  String
  status       JournalEntryStatus @default(POSTED)
  source       String
  sourceId     String?            @map("source_id")
  postedAt     DateTime           @default(now()) @map("posted_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz
  reversedById String?            @map("reversed_by_id") @db.Uuid
  reversedBy   JournalEntry?      @relation("JournalReversal", fields: [reversedById], references: [id])
  reversals    JournalEntry[]     @relation("JournalReversal")

  lines JournalLine[]

  @@unique([tenantId, entryNumber])
  @@index([tenantId, status])
  @@index([tenantId, postedAt])
  @@index([sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @map("account_id") @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(15, 2)
  credit         Decimal      @default(0) @db.Decimal(15, 2)
  description    String?

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_lines")
}

model PaymentTransaction {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId       String?  @map("invoice_id")
  installmentId   String?  @map("installment_id")
  amount          Decimal  @db.Decimal(12, 2)
  fee             Decimal  @default(0) @db.Decimal(12, 2)
  netAmount       Decimal  @db.Decimal(12, 2)
  currency        String   @default("SAR")
  method          String
  status          String   @default("COMPLETED")
  gatewayRef      String?  @map("gateway_ref")
  gatewayResponse String?  @map("gateway_response") @db.Text
  paidAt          DateTime @default(now()) @map("paid_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId])
  @@index([invoiceId])
  @@index([installmentId])
  @@index([status])
  @@map("payment_transactions")
}

