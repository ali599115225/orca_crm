// 1. المولد الأساسي للـ Prisma Client
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}


// --- ENUMS ---
enum Role {
  ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  MARKETING
  READ_ONLY
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
  SOLD_OUT
}

enum LeadStatus {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  RESERVED
  CONTRACT_SIGNED
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

// --- MODELS ---

model User {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String            @map("tenant_id") @db.Uuid
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  email          String            @unique
  passwordHash   String            @map("password_hash")
  role           Role
  isActive       Boolean           @default(true) @map("is_active")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  leads          Lead[]            @relation("AssignedLeads")
  leadActivities LeadActivity[]
  tasks          Task[]
  commissions    PayrollCommission[]

  @@map("users")
}

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name           String
  city           String
  status         ProjectStatus
  unitsTotal     Int           @default(0) @map("units_total")
  unitsSold      Int           @default(0) @map("units_sold")
  unitsBooked    Int           @default(0) @map("units_booked")
  minPrice       Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice       Decimal?      @map("max_price") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  leads          Lead[]
  units          Unit[]

  @@map("projects")
}

model Lead {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId      String?        @map("project_id") @db.Uuid
  project        Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo     String?        @map("assigned_to") @db.Uuid
  assignedUser   User?          @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  firstName      String         @map("first_name")
  lastName       String?        @map("last_name")
  phone          String
  email          String?
  city           String
  source         String
  status         LeadStatus
  lostReason     String?        @map("lost_reason")
  leadScore      Int            @default(50) @map("lead_score")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  leadActivities LeadActivity[]
  tasks          Task[]
  mansourChats   MansourChat[]
  stage          String?
  score          Int?
  assignedAgentId String?        @map("assigned_agent_id") @db.Uuid
  unitId         String?        @map("unit_id") @db.Uuid
  createdBy      String?        @map("created_by") @db.Uuid
  updatedBy      String?        @map("updated_by") @db.Uuid
  auditLog       String?        @map("audit_log") @db.Text

  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityType String   @map("activity_type")
  description  String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("lead_activities")
}

model Task {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String     @map("lead_id") @db.Uuid
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   String     @map("assigned_to") @db.Uuid
  assignedUser User       @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime   @map("due_date") @db.Timestamptz
  priority     Priority
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  auditLog     String?    @map("audit_log") @db.Text

  @@map("tasks")
}

model Tenant {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName           String        @map("company_name")
  subdomain             String        @unique
  subscriptionPlan      String        @default("basic") @map("subscription_plan")
  isActive              Boolean       @default(true) @map("is_active")
  contractTerms         String?       @map("contract_terms") @db.Text
  commercialRegistry    String?       @map("commercial_registry")
  vatNumber             String?       @map("vat_number")
  nationalAddress       String?       @map("national_address")
  encryptedClientId     String?       @map("encrypted_client_id")
  encryptedClientSecret String?       @map("encrypted_client_secret")
  encryptedApiKey       String?       @map("encrypted_api_key")
  encryptedZatcaCredentials String?   @map("encrypted_zatca_credentials")
  
  subscriptionExpiresAt DateTime?     @map("subscription_expires_at") @db.Timestamptz
  paymentStatus         String        @default("UNPAID") @map("payment_status")
  billingCycle          String        @default("MONTHLY") @map("billing_cycle")
  extraAgents           Int           @default(0) @map("extra_agents")
  whatsappConnected     Boolean       @default(false) @map("whatsapp_connected")
  growthWarning         Boolean       @default(false) @map("growth_warning")

  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  users                 User[]
  projects              Project[]
  leads                 Lead[]
  leadActivities        LeadActivity[]
  tasks                 Task[]
  tickets               Ticket[]
  agentSlots            AgentSlot[]
  usageMeters           UsageMeter[]
  commissions           PayrollCommission[]
  agentTelemetryLogs    AgentTelemetryLog[]
  auditLogs             AuditLog[]
  followupSequences     FollowupSequence[]
  mansourChats          MansourChat[]
  platformConnections   PlatformConnection[]
  agentLeases           AgentLease[]
  contacts              Contact[]
  opportunities         Opportunity[]
  tours                 Tour[]
  offers                Offer[]
  automationWorkflows   AutomationWorkflow[]
  telemetryEvents       TelemetryEvent[]

  @@map("tenants")
}

model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  status      String   @default("OPEN")
  aiResponse  String?  @map("ai_response") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tickets")
}

model AgentSlot {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotNumber  Int         @map("slot_number")
  agentType   String      @map("agent_type")
  isActive    Boolean     @default(true) @map("is_active")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  usageMeter  UsageMeter?

  @@unique([tenantId, slotNumber])
  @@map("agent_slots")
}

model UsageMeter {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentSlotId String?     @unique @map("agent_slot_id") @db.Uuid
  agentSlot   AgentSlot?  @relation(fields: [agentSlotId], references: [id], onDelete: SetNull)
  metricType  String      @map("metric_type")
  limitValue  Int         @map("limit_value")
  usageValue  Int         @default(0) @map("usage_value")
  resetAt     DateTime    @map("reset_at") @db.Timestamptz
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("usage_meters")
}

model PayrollCommission {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String      @map("tenant_id") @db.Uuid
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Decimal     @db.Decimal(12, 2)
  contractId  String      @map("contract_id")
  status      String      @default("PENDING")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("payroll_commissions")
}

model Unit {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String     @map("project_id") @db.Uuid
  project       Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitNumber    String     @map("unit_number")
  floorPosition Int        @map("floor_position")
  priceSar      Decimal    @map("price_sar") @db.Decimal(12, 2)
  type          String?    @default("شقة سكنية")
  area          String?    @default("120 م²")
  description   String?    @db.Text
  media         Json?      @default("[]")
  docs          Json?      @default("[]")
  events        Json?      @default("[]")
  handovers     Json?      @default("[]")
  status        String     @default("Available")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contract      Contract?

  @@unique([projectId, unitNumber], name: "uq_project_unit_number")
  @@index([projectId], map: "idx_units_project_id")
  @@map("units")
}

model Contract {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId         String        @unique @map("unit_id") @db.Uuid
  unit           Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  buyerName      String        @map("buyer_name")
  buyerPhone     String        @map("buyer_phone")
  totalVolumeSar Decimal       @map("total_volume_sar") @db.Decimal(12, 2)
  signedAt       DateTime      @default(now()) @map("signed_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  installments   Installment[]

  @@index([unitId], map: "idx_contracts_unit_id")
  @@map("contracts")
}

model Installment {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId         String   @map("contract_id") @db.Uuid
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  installmentNumber  Int      @map("installment_number")
  amountSar          Decimal  @map("amount_sar") @db.Decimal(12, 2)
  dueDate            DateTime @map("due_date") @db.Date
  paymentStatus      String   @default("Pending") @map("payment_status")
  securePaymentToken String   @unique @default(dbgenerated("gen_random_uuid()")) @map("secure_payment_token") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([contractId, installmentNumber], name: "uq_contract_installment_number")
  @@index([contractId], map: "idx_installments_contract_id")
  @@index([dueDate], map: "idx_installments_due_date")
  @@map("installments")
}

model AgentTelemetryLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId      String   @map("agent_id")
  actionType   String   @map("action_type")
  logMessageAr String   @map("log_message_ar") @db.Text
  severity     String   @default("Info")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId], map: "idx_telemetry_tenant_id")
  @@index([createdAt(sort: Desc)], map: "idx_telemetry_created_at")
  @@map("agent_telemetry_logs")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @map("user_id") @db.Uuid
  action    String
  tableName String   @map("table_name")
  recordId  String   @map("record_id")
  details   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId], map: "idx_audit_logs_tenant_id")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}

model FollowupSequence {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status    String
  delayDays Int      @map("delay_days")
  message   String   @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("followup_sequences")
}

model MansourChat {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String?  @map("lead_id") @db.Uuid
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactName  String   @map("contact_name")
  contactPhone String   @map("contact_phone")
  lastMessage  String   @map("last_message") @db.Text
  status       String   @default("INTERESTED")
  messagesJson String   @map("messages_json") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("mansour_chats")
}

model PlatformConnection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform        String
  accountId       String   @map("account_id")
  encryptedApiKey String?  @map("encrypted_api_key") @db.Text
  status          String   @default("DISCONNECTED")
  leadTone        String   @default("PROFESSIONAL")
  autoWelcomeMsg  String   @default("") @map("auto_welcome_msg") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, platform])
  @@map("platform_connections")
}

model AgentLease {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentId     String   @map("agent_id")
  startDate   DateTime @map("start_date") @db.Timestamptz
  endDate     DateTime @map("end_date") @db.Timestamptz
  leasePrice  Decimal  @map("lease_price") @db.Decimal(10, 2)
  autoRenewal Boolean  @default(false) @map("auto_renewal")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, agentId])
  @@map("agent_leases")
}

model Receipt {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Decimal
  paymentMethod String
  receivedDate  DateTime      @default(now())
  status        String        @default("COMPLETED")
  ledgerEntry   GeneralLedger?
}

model GeneralLedger {
  id          String   @id @default(uuid())
  receiptId   String?  @unique
  receipt     Receipt? @relation(fields: [receiptId], references: [id])
  debit       Decimal
  credit      Decimal
  description String
  createdAt   DateTime @default(now())
}

model Contact {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId               String?  @map("lead_id") @db.Uuid
  name                 String
  phone                String
  email                String?
  preferredContactTime String?  @map("preferred_contact_time")
  budgetRange          String?  @map("budget_range")
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy            String?  @map("created_by") @db.Uuid
  updatedBy            String?  @map("updated_by") @db.Uuid
  auditLog             String?  @map("audit_log") @db.Text

  @@map("contacts")
}

model Opportunity {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId        String   @map("lead_id") @db.Uuid
  value         Decimal  @db.Decimal(12, 2)
  probability   Int
  closeDate     DateTime @map("close_date") @db.Timestamptz
  status        String   @default("OPEN")
  linkedUnitIds String?  @map("linked_unit_ids") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid
  updatedBy     String?  @map("updated_by") @db.Uuid
  auditLog      String?  @map("audit_log") @db.Text
  offers        Offer[]

  @@map("opportunities")
}

model Tour {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId     String   @map("lead_id") @db.Uuid
  assignedTo String   @map("assigned_to") @db.Uuid
  startAt    DateTime @map("start_at") @db.Timestamptz
  endAt      DateTime @map("end_at") @db.Timestamptz
  location   String
  status     String   @default("SCHEDULED")
  attendees  Int      @default(1)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid
  updatedBy  String?  @map("updated_by") @db.Uuid
  auditLog   String?  @map("audit_log") @db.Text

  @@map("tours")
}

model Offer {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String      @map("tenant_id") @db.Uuid
  tenant              Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  linkedOpportunityId String      @map("linked_opportunity_id") @db.Uuid
  opportunity         Opportunity @relation(fields: [linkedOpportunityId], references: [id], onDelete: Cascade)
  price               Decimal     @db.Decimal(12, 2)
  validUntil          DateTime    @map("valid_until") @db.Timestamptz
  status              String      @default("PENDING")
  documentUrl         String?     @map("document_url")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy           String?     @map("created_by") @db.Uuid
  updatedBy           String?     @map("updated_by") @db.Uuid
  auditLog            String?     @map("audit_log") @db.Text

  @@map("offers")
}

model AutomationWorkflow {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  triggerEvent String   @map("trigger_event")
  actionsJson  String   @map("actions_json") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid
  auditLog     String?  @map("audit_log") @db.Text

  @@map("automation_workflows")
}

model TelemetryEvent {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType     String   @map("event_type")
  eventDataJson String   @map("event_data_json") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by") @db.Uuid
  auditLog      String?  @map("audit_log") @db.Text

  @@map("telemetry_events")
}
