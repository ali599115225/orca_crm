  phoneHash   String   @map("phone_hash")
  consentedAt DateTime @map("consented_at") @db.Timestamptz
  consentType String   @map("consent_type") // EXPLICIT | IMPLIED | WITHDRAWN
  source      String?  @map("source") // WEBHOOK | MANUAL | IMPORT
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, phoneHash])
  @@map("whatsapp_consents")
}

model WhatsAppOptOut {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  phone      String
  phoneHash  String   @map("phone_hash")
  reason     String?
  source     String?
  optedOutAt DateTime @default(now()) @map("opted_out_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([tenantId, phoneHash])
  @@map("whatsapp_opt_outs")
