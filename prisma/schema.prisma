// ═══════════════════════════════════════════════════════════
// WHATSAPP MULTI-TENANT SYSTEM — P0 Batch 1
// ═══════════════════════════════════════════════════════════

enum WhatsAppConnectionStatus {
  DISCONNECTED
  SIGNUP_PENDING
  TOKEN_EXCHANGED
  ASSETS_VERIFIED
  WEBHOOK_SUBSCRIBED
  ACTIVE
  REAUTH_REQUIRED
  SUSPENDED
  DISCONNECTING
  DISCONNECT_PENDING
  FAILED
}

enum WhatsAppSignupSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

enum WhatsAppWebhookEnvelopeStatus {
  RECEIVED
  PROCESSED
  INVALID_SIGNATURE
  QUARANTINED
  DISCARDED
}

enum WhatsAppWebhookEventType {
  INBOUND_MESSAGE
  STATUS_UPDATE
  UNKNOWN
}

enum WhatsAppWebhookEventStatus {
  PENDING
  PROCESSED
  QUARANTINED
  DLQ
  RETRYING
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum WhatsAppTemplateSyncStatus {
  APPROVED
  REJECTED
  PENDING
  PAUSED
  DISABLED
}

enum WhatsAppIntegrationAuditAction {
  CONNECTED
  DISCONNECTED
  TOKEN_ROTATED
  SIGNUP_INITIATED
  SIGNUP_COMPLETED
  SIGNUP_FAILED
  PHONE_ADDED
  PHONE_REMOVED
  PRIMARY_CHANGED
  CREDENTIAL_EXPIRED
  AUTOMATION_ENABLED
  AUTOMATION_DISABLED
  TEMPLATE_SYNCED
  KILL_SWITCH_ENGAGED
}

model WhatsAppConnection {
  id              String                   @id @default(uuid()) @db.Uuid
  tenantId        String                   @map("tenant_id") @db.Uuid
  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status          WhatsAppConnectionStatus @default(DISCONNECTED)
  wabaId          String?                  @unique @map("waba_id")
  activeSince     DateTime?                @map("active_since") @db.Timestamptz
  disconnectedAt  DateTime?                @map("disconnected_at") @db.Timestamptz
  lastHealthCheck DateTime?                @map("last_health_check") @db.Timestamptz
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  credentials    WhatsAppCredential[]
  phoneNumbers   WhatsAppPhoneNumber[]
  templates      WhatsAppTemplate[]
  signupSessions WhatsAppSignupSession[]
  auditLogs      WhatsAppIntegrationAudit[]

  @@unique([tenantId])
  @@index([status])
  @@map("whatsapp_connections")
}

model WhatsAppCredential {
  id                    String                     @id @default(uuid()) @db.Uuid
  connectionId          String                     @map("connection_id") @db.Uuid
  connection            WhatsAppConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  encryptedValue        String                     @map("encrypted_value")
  iv                    String
  authTag               String                     @map("auth_tag")
  algorithm             String                     @default("AES-256-GCM") @map("algorithm")
  keyVersion            Int                        @default(1) @map("key_version")
  tokenFingerprint      String                     @map("token_fingerprint")
  issuedAt              DateTime                   @default(now()) @map("issued_at") @db.Timestamptz
  lastValidatedAt       DateTime?                  @map("last_validated_at") @db.Timestamptz
  revokedAt             DateTime?                  @map("revoked_at") @db.Timestamptz
  rotatedFrom           String?                    @map("rotated_from") @db.Uuid
  rotatedFromCredential WhatsAppCredential?        @relation("WhatsAppCredentialRotation", fields: [rotatedFrom], references: [id], onDelete: SetNull)
  rotatedTo             WhatsAppCredential[]       @relation("WhatsAppCredentialRotation")
  isActive              Boolean                    @default(true) @map("is_active")
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  auditLogs             WhatsAppIntegrationAudit[]

  @@index([connectionId])
  @@index([tokenFingerprint])
  @@map("whatsapp_credentials")
}

// WhatsAppPhoneNumber REFINEMENT — connectionId made mandatory, isPrimary added
model WhatsAppPhoneNumber {
  id                 String                     @id @default(uuid()) @db.Uuid
  tenantId           String                     @map("tenant_id") @db.Uuid
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId       String?                    @map("connection_id") @db.Uuid
  connection         WhatsAppConnection?        @relation(fields: [connectionId], references: [id])
  phoneNumberId      String                     @unique @map("phone_number_id")
  displayPhoneNumber String?                    @map("display_phone_number")
  wabaId             String?                    @map("waba_id")
  businessAccountId  String?                    @map("business_account_id")
  isActive           Boolean                    @default(true) @map("is_active")
  isPrimary          Boolean                    @default(false) @map("is_primary")
  verifiedName       String?                    @map("verified_name")
  qualityRating      String?                    @map("quality_rating")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz
  auditLogs          WhatsAppIntegrationAudit[]

  @@index([tenantId, isActive])
  @@index([connectionId])
  @@map("whatsapp_phone_numbers")
}

model WhatsAppSignupSession {
  id           String                      @id @default(uuid()) @db.Uuid
  tenantId     String                      @map("tenant_id") @db.Uuid
  tenant       Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String                      @map("user_id") @db.Uuid
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId String?                     @map("connection_id") @db.Uuid
  connection   WhatsAppConnection?         @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  stateHash    String                      @unique @map("state_hash")
  codeVerifier String?                     @map("code_verifier")
  redirectUri  String                      @map("redirect_uri")
  status       WhatsAppSignupSessionStatus @default(PENDING)
  expiresAt    DateTime                    @map("expires_at") @db.Timestamptz
  completedAt  DateTime?                   @map("completed_at") @db.Timestamptz
  createdAt    DateTime                    @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, status])
  @@map("whatsapp_signup_sessions")
}

model WhatsAppWebhookEnvelope {
  id                String                        @id @default(uuid()) @db.Uuid
  requestHash       String                        @map("request_hash")
  signatureValid    Boolean                       @default(false) @map("signature_valid")
  status            WhatsAppWebhookEnvelopeStatus @default(RECEIVED)
  rawPayloadSnippet String?                       @map("raw_payload_snippet") @db.Text
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz
  expiresAt         DateTime                      @map("expires_at") @db.Timestamptz

  events WhatsAppWebhookEvent[]

  @@index([status])
  @@index([expiresAt])
  @@map("whatsapp_webhook_envelopes")
}

model WhatsAppWebhookEvent {
  id            String                     @id @default(uuid()) @db.Uuid
  envelopeId    String                     @map("envelope_id") @db.Uuid
  envelope      WhatsAppWebhookEnvelope    @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  tenantId      String?                    @map("tenant_id") @db.Uuid
  tenant        Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  wabaId        String?                    @map("waba_id")
  phoneNumberId String?                    @map("phone_number_id")
  eventType     WhatsAppWebhookEventType   @map("event_type")
  messageId     String?                    @map("message_id") @db.Uuid
  message       WhatsAppMessage?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  metaMessageId String?                    @map("meta_message_id")
  occurredAt    DateTime?                  @map("occurred_at") @db.Timestamptz
  eventData     Json                       @map("event_data")
  dedupeKey     String                     @unique @map("dedupe_key")
  status        WhatsAppWebhookEventStatus @default(PENDING)
  attemptCount  Int                        @default(0) @map("attempt_count")
  maxAttempts   Int                        @default(3) @map("max_attempts")
  lastError     String?                    @map("last_error")
  nextRetryAt   DateTime?                  @map("next_retry_at") @db.Timestamptz
  processedAt   DateTime?                  @map("processed_at") @db.Timestamptz
  createdAt     DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  @@index([envelopeId])
  @@index([messageId])
  @@index([tenantId, status])
  @@index([status, nextRetryAt])
  @@map("whatsapp_webhook_events")
}

model WhatsAppTemplate {
  id             String                     @id @default(uuid()) @db.Uuid
  tenantId       String                     @map("tenant_id") @db.Uuid
  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  connectionId   String                     @map("connection_id") @db.Uuid
  connection     WhatsAppConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  metaTemplateId String                     @map("meta_template_id")
  name           String
  language       String
  category       WhatsAppTemplateCategory
  metaStatus     WhatsAppTemplateSyncStatus @map("meta_status")
  isEnabled      Boolean                    @default(false) @map("is_enabled")
  qualityScore   String?                    @map("quality_score")
  components     Json?
  variables      Json?
  lastSyncedAt   DateTime                   @default(now()) @map("last_synced_at") @db.Timestamptz
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([connectionId, metaTemplateId, language])
  @@index([connectionId, metaStatus])
  @@index([connectionId, isEnabled])
  @@map("whatsapp_templates")
}

model WhatsAppIntegrationAudit {
  id            String                         @id @default(uuid()) @db.Uuid
  tenantId      String                         @map("tenant_id") @db.Uuid
  tenant        Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String?                        @map("user_id") @db.Uuid
  user          User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  connectionId  String?                        @map("connection_id") @db.Uuid
  connection    WhatsAppConnection?            @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  credentialId  String?                        @map("credential_id") @db.Uuid
  credential    WhatsAppCredential?            @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  phoneNumberId String?                        @map("phone_number_id")
  phoneNumber   WhatsAppPhoneNumber?           @relation(fields: [phoneNumberId], references: [phoneNumberId], onDelete: SetNull)
  action        WhatsAppIntegrationAuditAction
  details       String?                        @db.Text
  createdAt     DateTime                       @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, createdAt])
  @@index([userId])
  @@index([connectionId])
  @@index([credentialId])
  @@index([phoneNumberId])
  @@map("whatsapp_integration_audits")
}

model WhatsAppConsent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
