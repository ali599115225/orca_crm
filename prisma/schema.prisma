// 1. المولد الأساسي للـ Prisma Client
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  CONTRA_ASSET
  CONTRA_REVENUE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum Role {
  ADMIN
  SALES_MANAGER
  SALES_EMPLOYEE
  MARKETING
  READ_ONLY
}

enum ProjectStatus {
  PLANNING
  UNDER_CONSTRUCTION
  COMPLETED
  SOLD_OUT
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VISIT_SCHEDULED
  VISITED
  OFFER_MADE
  NEGOTIATION
  RESERVED
  CONTRACT_SIGNED
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum InvoiceType {
  SALE
  RENTAL
}

enum TourStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  FOLLOW_UP
}

// --- MODELS ---

model User {
  id                        String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                  String                     @map("tenant_id") @db.Uuid
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                      String
  email                     String                     @unique
  emailHash                 String?                    @map("email_hash")
  passwordHash              String                     @map("password_hash")
  role                      Role
  isActive                  Boolean                    @default(true) @map("is_active")
  jobTitle                  String?                    @map("job_title")
  department                String?
  phone                     String?
  contractStartAt           DateTime?                  @map("contract_start_at") @db.Timestamptz
  contractEndAt             DateTime?                  @map("contract_end_at") @db.Timestamptz
  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  leads                     Lead[]                     @relation("AssignedLeads")
  archivedLeads             Lead[]                     @relation("ArchivedLeads")
  leadActivities            LeadActivity[]
  tasks                     Task[]
  assignedTours             Tour[]                     @relation("AssignedTours")
  commissions               PayrollCommission[]
  emailMessages             EmailMessage[]
  whatsappSignupSessions    WhatsAppSignupSession[]
  whatsappIntegrationAudits WhatsAppIntegrationAudit[]
  sentinelRequestedTasks    SentinelTaskOrder[]        @relation("SentinelTaskOrderRequestedBy")
  sentinelDecidedTasks      SentinelTaskOrder[]        @relation("SentinelTaskOrderDecidedBy")
  sentinelIncidents         SentinelIncident[]

  @@index([emailHash], map: "idx_users_email_hash")
  @@map("users")
}

model Project {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  city        String
  status      ProjectStatus
  unitsTotal  Int           @default(0) @map("units_total")
  unitsSold   Int           @default(0) @map("units_sold")
  unitsBooked Int           @default(0) @map("units_booked")
  minPrice    Decimal?      @map("min_price") @db.Decimal(12, 2)
  maxPrice    Decimal?      @map("max_price") @db.Decimal(12, 2)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  leads       Lead[]
  units       Unit[]

  @@map("projects")
}

model Lead {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String           @map("tenant_id") @db.Uuid
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId       String?          @map("project_id") @db.Uuid
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assignedTo      String?          @map("assigned_to") @db.Uuid
  assignedUser    User?            @relation("AssignedLeads", fields: [assignedTo], references: [id], onDelete: SetNull)
  firstName       String           @map("first_name")
  lastName        String?          @map("last_name")
  phone           String
  phoneHash       String?          @map("phone_hash")
  email           String?
  emailHash       String?          @map("email_hash")
  city            String
  source          String
  status          LeadStatus
  lostReason      String?          @map("lost_reason")
  leadScore       Int              @default(50) @map("lead_score")
  lastContactedAt DateTime?        @map("last_contacted_at") @db.Timestamptz
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  leadActivities  LeadActivity[]
  tasks           Task[]
  tours           Tour[]
  contracts       Contract[]
  opportunities   Opportunity[]
  mansourChats    MansourChat[]
  whatsappContact WhatsAppContact?
  emailMessages   EmailMessage[]
  stage           String?
  score           Int?
  priority        String?
  aiSummary       String?          @map("ai_summary") @db.Text
  assignedAgentId String?          @map("assigned_agent_id") @db.Uuid
  unitId          String?          @map("unit_id") @db.Uuid
  createdBy       String?          @map("created_by") @db.Uuid
  updatedBy       String?          @map("updated_by") @db.Uuid
  auditLog        String?          @map("audit_log") @db.Text
  isArchived      Boolean          @default(false) @map("is_archived")
  archivedAt      DateTime?        @map("archived_at") @db.Timestamptz
  archiveReason   String?          @map("archive_reason")
  archivedById    String?          @map("archived_by_id") @db.Uuid
  archivedBy      User?            @relation("ArchivedLeads", fields: [archivedById], references: [id], onDelete: SetNull)

  @@index([tenantId, phoneHash], map: "idx_leads_tenant_phone_hash")
  @@index([tenantId, isArchived, status], map: "idx_leads_tenant_archived_status")
  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String   @map("lead_id") @db.Uuid
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId       String?  @map("user_id") @db.Uuid
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  activityType String   @map("activity_type")
  description  String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("lead_activities")
}

model Task {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId       String     @map("lead_id") @db.Uuid
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo   String     @map("assigned_to") @db.Uuid
  assignedUser User       @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  title        String
  description  String?
  dueDate      DateTime   @map("due_date") @db.Timestamptz
  priority     Priority
  status       TaskStatus @default(PENDING)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?    @map("created_by") @db.Uuid
  updatedBy    String?    @map("updated_by") @db.Uuid
  auditLog     String?    @map("audit_log") @db.Text

  @@map("tasks")
}

model Tenant {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyName                 String    @map("company_name")
  subdomain                   String    @unique
  subscriptionPlan            String    @default("basic") @map("subscription_plan")
  isActive                    Boolean   @default(true) @map("is_active")
  contractTerms               String?   @map("contract_terms") @db.Text
  commercialRegistry          String?   @map("commercial_registry")
  vatNumber                   String?   @map("vat_number")
  nationalAddress             String?   @map("national_address")
  encryptedClientId           String?   @map("encrypted_client_id")
  encryptedClientSecret       String?   @map("encrypted_client_secret")
  encryptedApiKey             String?   @map("encrypted_api_key")
  encryptedZatcaCredentials   String?   @map("encrypted_zatca_credentials")
  invoicePrefix               String    @default("INV") @map("invoice_prefix")
  nextInvoiceNumber           Int       @default(1) @map("next_invoice_number")
  nextJournalNumber           Int       @default(1) @map("next_journal_number")
  leadsWebhookKeyId           String?   @unique @map("leads_webhook_key_id")
  encryptedLeadsWebhookSecret String?   @map("encrypted_leads_webhook_secret") @db.Text
  leadsWebhookSecretUpdatedAt DateTime? @map("leads_webhook_secret_updated_at") @db.Timestamptz

  subscriptionExpiresAt DateTime? @map("subscription_expires_at") @db.Timestamptz
  paymentStatus         String    @default("UNPAID") @map("payment_status")
  billingCycle          String    @default("MONTHLY") @map("billing_cycle")
  extraAgents           Int       @default(0) @map("extra_agents")
  whatsappConnected     Boolean   @default(false) @map("whatsapp_connected")
  growthWarning         Boolean   @default(false) @map("growth_warning")
  messagingDisabled     Boolean   @default(false) @map("messaging_disabled")
  automationDisabled    Boolean   @default(false) @map("automation_disabled")

  whatsappConnection WhatsAppConnection?

  createdAt                 DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  users                     User[]
  projects                  Project[]
  leads                     Lead[]
  leadActivities            LeadActivity[]
  tasks                     Task[]
  tickets                   Ticket[]
  agentSlots                AgentSlot[]
  usageMeters               UsageMeter[]
  commissions               PayrollCommission[]
  agentTelemetryLogs        AgentTelemetryLog[]
  auditLogs                 AuditLog[]
  followupSequences         FollowupSequence[]
  mansourChats              MansourChat[]
  platformConnections       PlatformConnection[]
  marketingCampaigns        MarketingCampaign[]        @relation("TenantMarketingCampaigns")
  marketingCampaignChannels MarketingCampaignChannel[] @relation("TenantMarketingCampaignChannels")
  agentLeases               AgentLease[]
  units                     Unit[]
  contracts                 Contract[]
  installments              Installment[]
  invoices                  Invoice[]
  receipts                  Receipt[]
  generalLedgerEntries      GeneralLedger[]
  contacts                  Contact[]
  opportunities             Opportunity[]
  tours                     Tour[]
  offers                    Offer[]
  automationWorkflows       AutomationWorkflow[]
  telemetryEvents           TelemetryEvent[]
  rentalLeases              RentalLease[]
  zatcaDevices              ZatcaDevice[]
  zatcaQueueItems           ZatcaQueue[]
  accounts                  Account[]
  accountBalances           AccountBalance[]
  journalEntries            JournalEntry[]
  paymentTransactions       PaymentTransaction[]
  paymentPlans              PaymentPlan[]
  commissionPayments        CommissionPayment[]
  maintenanceTickets        MaintenanceTicket[]
  whatsappContacts          WhatsAppContact[]
  whatsappPhoneNumbers      WhatsAppPhoneNumber[]
  whatsappMessages          WhatsAppMessage[]
  emailMessages             EmailMessage[]
  whatsappSignupSessions    WhatsAppSignupSession[]
  whatsappWebhookEvents     WhatsAppWebhookEvent[]
  whatsappTemplates         WhatsAppTemplate[]
  whatsappIntegrationAudits WhatsAppIntegrationAudit[]
  whatsappConsents          WhatsAppConsent[]
  whatsappOptOuts           WhatsAppOptOut[]
  dealPassports             DealPassport[]
  dealEvents                DealEvent[]
  revenueIntelligenceScores RevenueIntelligenceScore[]
  governmentOutboxEntries   GovernmentOutbox[]
  sentinelIncidents         SentinelIncident[]
  documents                 Document[]

  @@map("tenants")
}

model Ticket {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  status      String   @default("OPEN")
  aiResponse  String?  @map("ai_response") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("tickets")
}

model AgentSlot {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slotNumber Int         @map("slot_number")
  agentType  String      @map("agent_type")
  isActive   Boolean     @default(true) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  usageMeter UsageMeter?

  @@unique([tenantId, slotNumber])
  @@map("agent_slots")
}

model UsageMeter {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agentSlotId String?    @unique @map("agent_slot_id") @db.Uuid
  agentSlot   AgentSlot? @relation(fields: [agentSlotId], references: [id], onDelete: SetNull)
  metricType  String     @map("metric_type")
  limitValue  Int        @map("limit_value")
  usageValue  Int        @default(0) @map("usage_value")
  resetAt     DateTime   @map("reset_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@map("usage_meters")
}

model PayrollCommission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(12, 2)
  contractId String   @map("contract_id")
  status     String   @default("PENDING")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  payments CommissionPayment[]

  @@map("payroll_commissions")
}

model Unit {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  projectId     String        @map("project_id") @db.Uuid
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitNumber    String        @map("unit_number")
  floorPosition Int           @map("floor_position")
  priceSar      Decimal       @map("price_sar") @db.Decimal(12, 2)
  type          String?       @default("شقة سكنية")
  area          String?       @default("120 م²")
  beds          Int?
  city          String?
  district      String?
  lat           Float?
  lng           Float?
  agentName     String?       @map("agent_name")
  description   String?       @db.Text
  media         Json?         @default("[]")
  docs          Json?         @default("[]")
  events        Json?         @default("[]")
  handovers     Json?         @default("[]")
  tourType      String?       @map("tour_type")
  tourUrl       String?       @map("tour_url")
  status        String        @default("Available")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  contract      Contract?
  tours         Tour[]        @relation("TourUnit")
  opportunities Opportunity[] @relation("OpportunityUnit")
  offers        Offer[]       @relation("OfferUnit")

  @@unique([projectId, unitNumber], name: "uq_project_unit_number", map: "uq_project_unit_number")
  @@index([projectId], map: "idx_units_project_id")
  @@index([tenantId], map: "idx_units_tenant_id")
  @@map("units")
}

model Contract {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId               String        @unique @map("unit_id") @db.Uuid
  unit                 Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)
  leadId               String?       @map("lead_id") @db.Uuid
  lead                 Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  offerId              String?       @unique @map("offer_id") @db.Uuid
  offer                Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  buyerName            String        @map("buyer_name")
  buyerPhone           String        @map("buyer_phone")
  buyerPhoneHash       String?       @map("buyer_phone_hash")
  totalVolumeSar       Decimal       @map("total_volume_sar") @db.Decimal(12, 2)
  acceptedAt           DateTime      @default(now()) @map("accepted_at") @db.Timestamptz
  reservationExpiresAt DateTime?     @map("reservation_expires_at") @db.Timestamptz
  signedAt             DateTime?     @map("signed_at") @db.Timestamptz
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz
  cancelReason         String?       @map("cancel_reason") @db.Text
  endDate              DateTime?     @map("end_date") @db.Timestamptz
  status               String        @default("PENDING_SIGNATURE")
  version              Int           @default(1)
  spineVersion         Int           @default(2) @map("spine_version")
  legacyFinancial      Boolean       @default(false) @map("legacy_financial")
  legacyReason         String?       @map("legacy_reason") @db.Text
  vatType              String        @default("STANDARD") @map("vat_type")
  vatRate              Decimal       @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz
  installments         Installment[]
  invoices             Invoice[]
  paymentPlan          PaymentPlan?
  dealPassport         DealPassport?

  @@index([unitId], map: "idx_contracts_unit_id")
  @@index([tenantId], map: "idx_contracts_tenant_id")
  @@index([tenantId, status], map: "idx_contracts_tenant_status")
  @@index([reservationExpiresAt], map: "idx_contracts_reservation_expiry")
  @@index([tenantId, buyerPhoneHash], map: "idx_contracts_tenant_buyer_phone_hash")
  @@index([leadId], map: "idx_contracts_lead_id")
  @@index([offerId], map: "idx_contracts_offer_id")
  @@index([tenantId, spineVersion, legacyFinancial], map: "idx_contracts_tenant_spine_legacy")
  @@map("contracts")
}

model PaymentPlan {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String        @map("tenant_id") @db.Uuid
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId       String        @unique @map("contract_id") @db.Uuid
  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  template         String        @default("SINGLE_PAYMENT")
  status           String        @default("DRAFT")
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  scheduleJson     Json          @default("[]") @map("schedule_json")
  installmentCount Int           @default(1) @map("installment_count")
  activatedAt      DateTime?     @map("activated_at") @db.Timestamptz
  completedAt      DateTime?     @map("completed_at") @db.Timestamptz
  version          Int           @default(1)
  lastAmendedAt    DateTime?     @map("last_amended_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  installments     Installment[]

  @@index([tenantId, status], map: "idx_payment_plans_tenant_status")
  @@index([lastAmendedAt], map: "idx_payment_plans_last_amended_at")
  @@map("payment_plans")
}

model Installment {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String               @map("tenant_id") @db.Uuid
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contractId         String               @map("contract_id") @db.Uuid
  contract           Contract             @relation(fields: [contractId], references: [id], onDelete: Cascade)
  invoiceId          String?              @map("invoice_id") @db.Uuid
  invoice            Invoice?             @relation("InvoiceInstallments", fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentPlanId      String?              @map("payment_plan_id") @db.Uuid
  paymentPlan        PaymentPlan?         @relation(fields: [paymentPlanId], references: [id], onDelete: SetNull)
  installmentNumber  Int                  @map("installment_number")
  amountSar          Decimal              @map("amount_sar") @db.Decimal(12, 2)
  vatAmount          Decimal?             @map("vat_amount") @db.Decimal(12, 2)
  dueDate            DateTime             @map("due_date") @db.Date
  paymentStatus      String               @default("Pending") @map("payment_status")
  securePaymentToken String               @unique @default(dbgenerated("gen_random_uuid()")) @map("secure_payment_token") @db.Uuid
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz
  payments           PaymentTransaction[]

  @@unique([contractId, installmentNumber], name: "uq_contract_installment_number")
  @@index([contractId], map: "idx_installments_contract_id")
  @@index([dueDate], map: "idx_installments_due_date")
  @@index([tenantId], map: "idx_installments_tenant_id")
  @@index([invoiceId], map: "idx_installments_invoice_id")
  @@index([paymentPlanId], map: "idx_installments_payment_plan_id")
  @@map("installments")
}

model RentalLease {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId       String?   @map("unit_id") @db.Uuid
  unitName     String    @map("unit_name")
  tenantName   String    @map("tenant_name")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  rentAmount   Decimal   @map("rent_amount") @db.Decimal(12, 2)
  deposit      Decimal   @default(0) @map("deposit") @db.Decimal(12, 2)
  currency     String    @default("SAR")
  status       String    @default("active")
  financialRef String?   @map("financial_ref")
  vatType      String    @default("STANDARD") @map("vat_type")
  vatRate      Decimal   @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  invoices     Invoice[]

  @@index([tenantId], map: "idx_rental_leases_tenant_id")
  @@map("rental_leases")
}

model Invoice {
  id         String       @id(map: "rental_invoices_pkey1") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "rental_invoices_tenant_id_fkey")
  type       InvoiceType  @default(RENTAL)
  leaseId    String?      @map("lease_id") @db.Uuid
  lease      RentalLease? @relation(fields: [leaseId], references: [id], onDelete: SetNull, map: "rental_invoices_lease_id_fkey")
  contractId String?      @map("contract_id") @db.Uuid
  contract   Contract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)

  invoiceNumber Int    @map("invoice_number")
  invoicePrefix String @default("INV") @map("invoice_prefix")
  zatcaUuid     String @default(dbgenerated("gen_random_uuid()")) @map("zatca_uuid") @db.Uuid

  issueDate DateTime @default(now()) @map("issue_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  subtotal    Decimal @map("subtotal") @db.Decimal(12, 2)
  vatRate     Decimal @default(15.00) @map("vat_rate") @db.Decimal(5, 2)
