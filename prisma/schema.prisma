  lastValidatedAt       DateTime?                  @map("last_validated_at") @db.Timestamptz
  revokedAt             DateTime?                  @map("revoked_at") @db.Timestamptz
  rotatedFrom           String?                    @map("rotated_from") @db.Uuid
  rotatedFromCredential WhatsAppCredential?        @relation("WhatsAppCredentialRotation", fields: [rotatedFrom], references: [id], onDelete: SetNull, map: "fk_whatsapp_credentials_rotated_from")
  rotatedTo             WhatsAppCredential[]       @relation("WhatsAppCredentialRotation")
  isActive              Boolean                    @default(true) @map("is_active")
  createdAt             DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  auditLogs             WhatsAppIntegrationAudit[]

  @@index([connectionId], map: "idx_whatsapp_credentials_connection")
  @@index([tokenFingerprint], map: "idx_whatsapp_credentials_fingerprint")
  @@map("whatsapp_credentials")
