"use client";
import { useState } from "react";

export default function Activities() {
  const [items] = useState([
    { id: "act1", type: "call", title: "مكالمة مع أحمد", time: "2026-06-02 14:30" },
    { id: "act2", type: "message", title: "رسالة واتساب لسارة", time: "2026-06-03 09:10" },
  ]);

  return (
    <div className="tab-pane">
      <h3 className="tab-pane-title">الأنشطة</h3>
      <div className="activity-list">
        {items.map((a) => (
          <div key={a.id} className="activity-item">
            <div className="activity-main">
              <div className="activity-title">{a.title}</div>
              <div className="activity-time text-muted">{a.time}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
