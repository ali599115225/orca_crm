"use client";
import { useState } from "react";

export default function Tasks() {
  const [tasks, setTasks] = useState([
    { id: "t1", title: "إرسال عرض سعر", due: "2026-06-06", status: "todo" },
    { id: "t2", title: "متابعة سارة", due: "2026-06-05", status: "inprogress" },
  ]);

  function toggle(id: string) {
    setTasks((prev) => prev.map(t => t.id === id ? { ...t, status: t.status === "todo" ? "inprogress" : t.status === "inprogress" ? "done" : "todo" } : t));
  }

  return (
    <div className="tab-pane">
      <h3 className="tab-pane-title">المهام</h3>
      <div className="grid grid-cols-3 gap-4">
        {["todo","inprogress","done"].map(col => (
          <div key={col} className="task-column">
            <div className="task-column-title">{col === "todo" ? "قيد التنفيذ" : col === "inprogress" ? "جارٍ العمل" : "مكتملة"}</div>
            <div className="task-list">
              {tasks.filter(t => t.status === col).map(t => (
                <div key={t.id} className="task-card">
                  <div className="task-title">{t.title}</div>
                  <div className="task-meta text-muted">{t.due}</div>
                  <button onClick={() => toggle(t.id)} className="btn-primary mt-2">تغيير الحالة</button>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
