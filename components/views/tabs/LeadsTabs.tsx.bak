"use client";

import { useState } from "react";
import Pipeline from "../pipeline/Pipeline";
import AIAnalysis from "./AIAnalysis";
import Activities from "./Activities";
import Tasks from "./Tasks";
import Details from "./Details";

const tabs = [
  { id: "pipeline", label: "الخط الزمني" },
  { id: "ai", label: "تحليل الذكاء الاصطناعي" },
  { id: "activities", label: "الأنشطة" },
  { id: "tasks", label: "المهام" },
  { id: "details", label: "التفاصيل" },
];

export default function LeadsTabs() {
  const [active, setActive] = useState("pipeline");

  return (
    <div className="leads-page p-6">
      <div className="flex items-center justify-between mb-6">
        <div>
          <div className="text-sm text-[#94A3B8]">Orca CRM</div>
          <h1 className="leads-title">نظام إدارة العملاء — ORCA CRM</h1>
        </div>

        <div className="flex items-center gap-3">
          <input placeholder="بحث شامل (العملاء، العقود)..." className="px-3 py-2 rounded-md bg-[#042A44] border border-[rgba(14,165,233,0.12)] text-white" />
          <button className="btn-primary">بحث</button>
        </div>
      </div>

      <div className="tabs-row flex gap-2 mb-4">
        {tabs.map((t) => (
          <button
            key={t.id}
            onClick={() => setActive(t.id)}
            className={`tab-btn ${active === t.id ? "tab-active" : "tab-inactive"}`}
          >
            {t.label}
          </button>
        ))}
      </div>

      <div className="tab-area">
        {active === "pipeline" && <Pipeline />}
        {active === "ai" && <AIAnalysis />}
        {active === "activities" && <Activities />}
        {active === "tasks" && <Tasks />}
        {active === "details" && <Details />}
      </div>
    </div>
  );
}
