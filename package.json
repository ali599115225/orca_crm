{
    "scripts": {
        "dev": "next dev",
        "build": "prisma generate && next build",
        "start": "next start",
        "postinstall": "prisma generate",
        "db-push": "prisma db push",
        "env:upload": "node scripts/upload-env-to-vercel.js",
        "jwt:generate": "node -e \"console.log('JWT_SECRET=\\\"' + require('crypto').randomBytes(64).toString('hex') + '\\\"')\"",
        "test": "vitest run",
        "test:sentinel": "vitest run tests/p2-sentinel-incidents.test.ts tests/p2-sentinel-command-center-incidents.test.ts tests/p2-sentinel-heartbeat-service.test.ts tests/p2-sentinel-cron-heartbeat.test.ts",
        "test:whatsapp": "vitest run tests/whatsapp/ tests/whatsapp-webhook-security.test.ts tests/whatsapp-persistence-foundation.test.ts",
        "test:smoke": "vitest run tests/p2-health-readiness.test.ts tests/auth.test.ts",
        "test:acceptance": "vitest run tests/auth.test.ts tests/tenant-isolation.test.ts tests/p2-health-readiness.test.ts tests/payment-service.test.ts tests/phase02-full-closure.test.ts && npm run test:whatsapp && npm run test:sentinel",
        "typecheck": "tsc --noEmit",
        "security:audit": "npm audit --omit=dev --audit-level=moderate",
        "g6:inventory": "node scripts/g6-operational-reliability-inventory.mjs",
        "g6:backup": "node scripts/g6-backup-plan.mjs",
        "g6:restore-drill": "node scripts/g6-restore-drill.mjs",
        "g7:reconcile": "node scripts/g7-remediation-reconciliation.mjs",
        "g8:gate": "node scripts/g8-final-foundation-gate.mjs"
    },
    "dependencies": {
