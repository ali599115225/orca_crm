        "@prisma/adapter-pg": "7.9.0",
        "@prisma/client": "7.9.0",
        "@sentry/nextjs": "10.67.0",
        "bcryptjs": "^3.0.3",
        "gsap": "^3.15.0",
        "jose": "^6.2.3",
        "lucide-react": "^1.16.0",
        "next": "16.2.11",
        "pg": "^8.21.0",
        "qrcode": "^1.5.4",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-hot-toast": "^2.6.0",
        "resend": "^6.12.4",
        "server-only": "0.0.1"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4.3.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "25.9.1",
        "@types/pg": "^8.20.0",
        "@types/qrcode": "^1.5.6",
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3",
        "autoprefixer": "^10.5.0",
        "dotenv": "^17.4.2",
        "jsdom": "^29.1.1",
        "postcss": "^8.5.15",
        "prisma": "7.9.0",
        "tailwindcss": "^4.3.2",
        "tsx": "^4.22.3",
