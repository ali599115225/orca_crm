{
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/sentinel",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/zatca",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/installments",
      "schedule": "0 8 * * *"
    }
  ],
  "buildCommand": "prisma generate && npx prisma db push --accept-data-loss && next build",
  "installCommand": "npm install",
  "framework": "nextjs"
}